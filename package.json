{
  "name": "kotoba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lessons:preview": "node scripts/preview-procedural-lesson.mjs",
    "dev": "vite --config apps/learner-next/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p apps/learner-next/tsconfig.json && vite build --config apps/learner-next/vite.config.ts",
    "preview": "vite preview --config apps/learner-next/vite.config.ts --host 127.0.0.1",
    "next:dev": "vite --config apps/learner-next/vite.config.ts --host 127.0.0.1",
    "next:build": "tsc -p apps/learner-next/tsconfig.json && vite build --config apps/learner-next/vite.config.ts",
    "next:preview": "vite preview --config apps/learner-next/vite.config.ts --host 127.0.0.1",
    "next:test": "vitest run --config apps/learner-next/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e.practice-flow.test.tsx",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "assets:sync": "node scripts/sync-assets.mjs",
    "audio:elevenlabs": "node scripts/generate-elevenlabs-audio.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:all": "npm run validate:curriculum && npm run audit:curriculum-source && npm run validate:assets && npm run lint:unit-content && npm run audit:unit-quality && npm run audit:curriculum-semantics && npm run audit:level-alignment",
    "lint:unit-content": "node scripts/lint-unit-content.mjs",
    "audit:unit-quality": "node scripts/audit-unit-quality.mjs",
    "audit:curriculum-semantics": "node scripts/audit-curriculum-semantics.mjs",
    "audit:sentence-naturalness": "node scripts/audit-sentence-naturalness.mjs --strict",
    "audit:procedural-naturalness": "node scripts/audit-procedural-naturalness.mjs",
    "audit:level-alignment": "node scripts/audit-level-alignment.mjs",
    "audit:curriculum-source": "node scripts/audit-curriculum-source.mjs",
    "audit:curriculum-pacing": "node scripts/audit-curriculum-pacing.mjs",
    "audit:curriculum-pacing:strict": "node scripts/audit-curriculum-pacing.mjs --strict",
    "audit:foundation-semantics": "node scripts/audit-foundation-semantics.mjs",
    "audit:word-distribution": "node scripts/audit-curriculum-pacing.mjs --distribution",
    "audit:word-distribution:strict": "node scripts/audit-curriculum-pacing.mjs --strict-distribution",
    "review:unit": "node scripts/export-curriculum-review-packet.mjs",
    "review:all": "node scripts/export-curriculum-review-packet.mjs --all",
    "curriculum:card": "node scripts/generate-card-candidate.mjs",
    "curriculum:rebuild-a1": "node scripts/rebuild-a1-units.mjs",
    "curriculum:rebuild-marugoto-a1": "node scripts/rebuild-a1-units.mjs",
    "curriculum:sync-word-pools": "node scripts/sync-curriculum-word-pools.mjs",
    "curriculum:sync-runtime-lexicon": "node scripts/sync-runtime-lexicon.mjs",
    "curriculum:unit-draft": "node scripts/generate-unit-draft.mjs",
    "dictionary:import": "python scripts/import-japanese-dictionary.py",
    "dictionary:bind": "python scripts/bind-curriculum-dictionary.py",
    "dictionary:curate": "python scripts/curate-dictionary.py",
    "dictionary:validate": "python scripts/validate-dictionary-study.py",
    "dictionary:audio-forms": "node scripts/sync-dictionary-audio-forms.mjs",
    "dictionary:audio": "node scripts/generate-dictionary-audio.mjs",
    "dictionary:pools": "python scripts/build-study-pools.py",
    "dictionary:validate-pools": "python scripts/build-study-pools.py --check",
    "curriculum:author-curated": "node scripts/author-curated-a1.mjs && node scripts/author-curated-a2.mjs && node scripts/author-curated-b1.mjs",
    "validate:curated": "node scripts/audit-curated-foundations.mjs && node scripts/validate-curated-course.mjs --complete=A1,A2 && node scripts/audit-curated-exposure.mjs && node scripts/audit-curated-grammar.mjs && node scripts/audit-curated-a1-scope.mjs",
    "curriculum:review-curated": "node scripts/export-curated-review.mjs",
    "reference:dev": "vite --host 127.0.0.1",
    "reference:build": "tsc -b && vite build",
    "reference:preview": "vite preview --host 127.0.0.1",
    "curriculum:compile-curated": "node scripts/compile-curated-catalog.mjs",
    "curriculum:audit-dependencies": "node scripts/audit-curated-dependencies.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": "20.x"
  }
}
