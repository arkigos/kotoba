      "path": "/media/jp/audio/unit_005/u005-c079.mp3",
      "text": "私は家で働きます",
      "speechText": "わたしわいえではたらきます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c080",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c080.mp3",
      "text": "学生は食べますか？",
      "speechText": "がくせいわたべますか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c081",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c081.mp3",
      "text": "旅行は去年でしたか？",
      "speechText": "りょこうわきょねんでしたか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c082",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c082.mp3",
      "text": "あなたは店で働きます",
      "speechText": "あなたわみせではたらきます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c083",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c083.mp3",
      "text": "先生は夜に勉強します",
      "speechText": "せんせいわよるにべんきょうします",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c084",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c084.mp3",
      "text": "父は聞きます",
      "speechText": "ちちわききます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c085",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c085.mp3",
      "text": "仕事は昨日でしたか？",
      "speechText": "しごとわきのうでしたか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c086",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c086.mp3",
      "text": "彼は会社で働きます",
      "speechText": "かれわかいしゃではたらきます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c087",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c087.mp3",
      "text": "友達は朝に勉強します",
      "speechText": "ともだちわあさにべんきょうします",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c088",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c088.mp3",
      "text": "人の家族です",
      "speechText": "ひとのかぞくです",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c089",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c089.mp3",
      "text": "休みは先月でしたか？",
      "speechText": "やすみわせんげつでしたか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c090",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c090.mp3",
      "text": "彼女は学校で勉強します",
      "speechText": "かのじょわがっこうでべんきょうします",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c091",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c091.mp3",
      "text": "家族は夜に働きます",
      "speechText": "かぞくわよるにはたらきます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c092",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c092.mp3",
      "text": "人は夜に飲みます",
      "speechText": "ひとわよるにのみます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c093",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c093.mp3",
      "text": "母は食べます",
      "speechText": "ははわたべます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c094",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c094.mp3",
      "text": "先月は旅行でしたか？",
      "speechText": "せんげつわりょこうでしたか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c095",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c095.mp3",
      "text": "学生は家で勉強します",
      "speechText": "がくせいわいえでべんきょうします",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c096",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c096.mp3",
      "text": "弟は朝に働きます",
      "speechText": "おとうとわあさにはたらきます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u005-c097",
      "status": "complete",
      "path": "/media/jp/audio/unit_005/u005-c097.mp3",
      "text": "彼は飲みますか？",
      "speechText": "かれわのみますか？",
      "provider": "elevenlabs"
