      "cardId": "u011-c087",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c087.mp3",
      "text": "どれが弟ですか？",
      "speechText": "どれがおとうとですか？"
    },
    {
      "cardId": "u011-c088",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c088.mp3",
      "text": "どの写真ですか？",
      "speechText": "どのしゃしんですか？"
    },
    {
      "cardId": "u011-c089",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c089.mp3",
      "text": "男の人は話しますよ",
      "speechText": "おとこのひとわはなしますよ"
    },
    {
      "cardId": "u011-c090",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c090.mp3",
      "text": "姉は待ちますね",
      "speechText": "あねわまちますね"
    },
    {
      "cardId": "u011-c091",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c091.mp3",
      "text": "母は聞きますよ",
      "speechText": "ははわききますよ"
    },
    {
      "cardId": "u011-c092",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c092.mp3",
      "text": "父は写真を見ますね",
      "speechText": "ちちわしゃしんをみますね"
    },
    {
      "cardId": "u011-c093",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c093.mp3",
      "text": "島は暑くないです",
      "speechText": "しまわあつくないです"
    },
    {
      "cardId": "u011-c094",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c094.mp3",
      "text": "椅子は寒くなかったです",
      "speechText": "いすわさむくなかったです"
    },
    {
      "cardId": "u011-c095",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c095.mp3",
      "text": "店は忙しくないです",
      "speechText": "みせわいそがしくないです"
    },
    {
      "cardId": "u011-c096",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c096.mp3",
      "text": "会社は楽しかったです",
      "speechText": "かいしゃわたのしかったです"
    },
    {
      "cardId": "u011-c097",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c097.mp3",
      "text": "図書館は難しくなかったです",
      "speechText": "としょかんわむずかしくなかったです"
    },
    {
      "cardId": "u011-c098",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c098.mp3",
      "text": "女の人は誰ですか？",
      "speechText": "おんなのひとわだれですか？"
    },
    {
      "cardId": "u011-c099",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c099.mp3",
      "text": "島は美味しいです",
      "speechText": "しまわおいしいです"
    },
    {
      "cardId": "u011-c100",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c100.mp3",
      "text": "椅子は早いですか？",
      "speechText": "いすわはやいですか？"
    },
    {
      "cardId": "u011-c101",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c101.mp3",
      "text": "犬は遅かったです",
      "speechText": "いぬわおそかったです"
    },
    {
      "cardId": "u011-c102",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c102.mp3",
      "text": "友達はかばんを見ますよ",
      "speechText": "ともだちわかばんをみますよ"
    },
    {
      "cardId": "u011-c103",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c103.mp3",
      "text": "かばんは暑くなかったです",
      "speechText": "かばんわあつくなかったです"
    },
    {
      "cardId": "u011-c104",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c104.mp3",
      "text": "学校は寒くないです",
      "speechText": "がっこうわさむくないです"
    },
    {
      "cardId": "u011-c105",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c105.mp3",
      "text": "駅は忙しかったです",
      "speechText": "えきわいそがしかったです"
    },
    {
      "cardId": "u011-c106",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c106.mp3",
      "text": "公園は楽しくなかったです",
      "speechText": "こうえんわたのしくなかったです"
    },
    {
      "cardId": "u011-c107",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c107.mp3",
      "text": "食べ物は何ですか？",
      "speechText": "たべものわなんですか？"
    },
    {
      "cardId": "u011-c108",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c108.mp3",
      "text": "海は易しいです",
      "speechText": "うみわやさしいです"
    },
    {
      "cardId": "u011-c109",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c109.mp3",
      "text": "かばんは美味しいですか？",
      "speechText": "かばんわおいしいですか？"
    },
    {
      "cardId": "u011-c110",
      "status": "queued",
      "path": "/media/jp/audio/unit_011/u011-c110.mp3",
      "text": "猫は早かったです",
