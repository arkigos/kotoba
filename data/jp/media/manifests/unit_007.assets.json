      "path": "/media/jp/audio/unit_007/u007-c031.mp3",
      "text": "水かお茶かどれですか？"
    },
    {
      "cardId": "u007-c032",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c032.mp3",
      "text": "本か鉛筆かどれですか？"
    },
    {
      "cardId": "u007-c033",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c033.mp3",
      "text": "かばんか鍵かどれですか？"
    },
    {
      "cardId": "u007-c034",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c034.mp3",
      "text": "時計か写真かどれですか？"
    },
    {
      "cardId": "u007-c035",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c035.mp3",
      "text": "猫か犬かどれですか？"
    },
    {
      "cardId": "u007-c036",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c036.mp3",
      "text": "店か駅かどれですか？"
    },
    {
      "cardId": "u007-c037",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c037.mp3",
      "text": "病院か会社かどれですか？"
    },
    {
      "cardId": "u007-c038",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c038.mp3",
      "text": "椅子か机かどれですか？"
    },
    {
      "cardId": "u007-c039",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c039.mp3",
      "text": "自転車か車かどれですか？"
    },
    {
      "cardId": "u007-c040",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c040.mp3",
      "text": "食べ物か飲み物かどれですか？"
    },
    {
      "cardId": "u007-c041",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c041.mp3",
      "text": "どの写真は母の物ですか？"
    },
    {
      "cardId": "u007-c042",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c042.mp3",
      "text": "どのかばんは姉の物ですか？"
    },
    {
      "cardId": "u007-c043",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c043.mp3",
      "text": "どの車は父の物ですか？"
    },
    {
      "cardId": "u007-c044",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c044.mp3",
      "text": "どの部屋は弟の物ですか？"
    },
    {
      "cardId": "u007-c045",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c045.mp3",
      "text": "どの鍵はケンの物ですか？"
    },
    {
      "cardId": "u007-c046",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c046.mp3",
      "text": "どの時計はユキの物ですか？"
    },
    {
      "cardId": "u007-c047",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c047.mp3",
      "text": "どの鉛筆は学生の物ですか？"
    },
    {
      "cardId": "u007-c048",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c048.mp3",
      "text": "どの本は先生の物ですか？"
    },
    {
      "cardId": "u007-c049",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c049.mp3",
      "text": "どの店は田中の物ですか？"
    },
    {
      "cardId": "u007-c050",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c050.mp3",
      "text": "どの飲み物は友達の物ですか？"
    },
    {
      "cardId": "u007-c051",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c051.mp3",
      "text": "昨日は何でしたか？"
    },
    {
      "cardId": "u007-c052",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c052.mp3",
      "text": "先月は何でしたか？"
    },
    {
      "cardId": "u007-c053",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c053.mp3",
      "text": "去年は何でしたか？"
    },
    {
      "cardId": "u007-c054",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c054.mp3",
      "text": "朝は何でしたか？"
    },
    {
      "cardId": "u007-c055",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c055.mp3",
      "text": "夜は何でしたか？"
    },
    {
      "cardId": "u007-c056",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c056.mp3",
      "text": "誕生日はどの休みでしたか？"
    },
    {
      "cardId": "u007-c057",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c057.mp3",
      "text": "旅行は誰の物でしたか？"
    },
    {
      "cardId": "u007-c058",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c058.mp3",
      "text": "仕事は誰の物でしたか？"
    },
    {
      "cardId": "u007-c059",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c059.mp3",
      "text": "テストはどの鉛筆のテストでしたか？"
    },
    {
      "cardId": "u007-c060",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c060.mp3",
      "text": "休みは誰の休みでしたか？"
    },
    {
      "cardId": "u007-c061",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c061.mp3",
      "text": "誰の家族ですか？"
    },
    {
      "cardId": "u007-c062",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c062.mp3",
      "text": "誰の母ですか？"
    },
    {
      "cardId": "u007-c063",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c063.mp3",
      "text": "誰の父ですか？"
    },
    {
      "cardId": "u007-c064",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c064.mp3",
      "text": "誰の姉ですか？"
    },
    {
      "cardId": "u007-c065",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c065.mp3",
      "text": "誰の弟ですか？"
    },
    {
      "cardId": "u007-c066",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c066.mp3",
      "text": "誰の写真ですか？"
    },
    {
      "cardId": "u007-c067",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c067.mp3",
      "text": "誰のかばんですか？"
    },
    {
      "cardId": "u007-c068",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c068.mp3",
      "text": "誰の車ですか？"
    },
    {
      "cardId": "u007-c069",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c069.mp3",
      "text": "誰の部屋ですか？"
    },
    {
      "cardId": "u007-c070",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c070.mp3",
      "text": "誰の鍵ですか？"
    },
    {
      "cardId": "u007-c071",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c071.mp3",
      "text": "私の名前は何ですか？"
    },
    {
      "cardId": "u007-c072",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c072.mp3",
      "text": "ケンは誰の友達ですか？"
    },
    {
      "cardId": "u007-c073",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c073.mp3",
      "text": "ユキは誰ですか？"
    },
    {
      "cardId": "u007-c074",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c074.mp3",
      "text": "田中はどの会社の人ですか？"
    },
    {
      "cardId": "u007-c075",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c075.mp3",
      "text": "日本かアメリカかどれですか？"
    },
    {
      "cardId": "u007-c076",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c076.mp3",
      "text": "先生は誰の先生ですか？"
    },
    {
      "cardId": "u007-c077",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c077.mp3",
      "text": "学生はどの学校の人ですか？"
    },
    {
      "cardId": "u007-c078",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c078.mp3",
      "text": "友達の飲み物は何ですか？"
    },
    {
      "cardId": "u007-c079",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c079.mp3",
      "text": "家族の食べ物はどれですか？"
    },
    {
      "cardId": "u007-c080",
      "status": "queued",
      "path": "/media/jp/audio/unit_007/u007-c080.mp3",
      "text": "これは誰の物ではありませんか？"
    }
