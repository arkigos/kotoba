      "path": "/media/jp/audio/unit_007/u007-c078.mp3",
      "text": "姉は聞きますか？",
      "speechText": "あねわききますか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c079",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c079.mp3",
      "text": "男の人は誰ですか？",
      "speechText": "おとこのひとわだれですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c080",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c080.mp3",
      "text": "彼女は食べ物を食べます",
      "speechText": "かのじょわたべものをたべます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c081",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c081.mp3",
      "text": "どの家ですか？",
      "speechText": "どのいえですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c082",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c082.mp3",
      "text": "あなたは夜に勉強します",
      "speechText": "あなたわよるにべんきょうします",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c083",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c083.mp3",
      "text": "どれが水ですか？",
      "speechText": "どれがみずですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c084",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c084.mp3",
      "text": "女の人は会社で待ちます",
      "speechText": "おんなのひとわかいしゃでまちます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c085",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c085.mp3",
      "text": "家族の部屋です",
      "speechText": "かぞくのへやです",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c086",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c086.mp3",
      "text": "家族は何ですか？",
      "speechText": "かぞくわなんですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c087",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c087.mp3",
      "text": "男の人は話します",
      "speechText": "おとこのひとわはなします",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c088",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c088.mp3",
      "text": "どの飲み物ですか？",
      "speechText": "どののみものですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c089",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c089.mp3",
      "text": "父は朝に働きます",
      "speechText": "ちちわあさにはたらきます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c090",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c090.mp3",
      "text": "友達は誰ですか？",
      "speechText": "ともだちわだれですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c091",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c091.mp3",
      "text": "彼は飲み物を飲みますか？",
      "speechText": "かれわのみものをのみますか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c092",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c092.mp3",
      "text": "男の人は駅で待ちます",
      "speechText": "おとこのひとわえきでまちます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c093",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c093.mp3",
      "text": "旅行は先月でしたか？",
      "speechText": "りょこうわせんげつでしたか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c094",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c094.mp3",
      "text": "どれがお茶ですか？",
      "speechText": "どれがおちゃですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c095",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c095.mp3",
      "text": "母は夜に勉強します",
      "speechText": "ははわよるにべんきょうします",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c096",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c096.mp3",
      "text": "女の人は見ます",
      "speechText": "おんなのひとわみます",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c097",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c097.mp3",
      "text": "弟は何ですか？",
      "speechText": "おとうとわなんですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c098",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c098.mp3",
      "text": "姉は誰ですか？",
      "speechText": "あねわだれですか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c099",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c099.mp3",
      "text": "休みは昨日でしたか？",
      "speechText": "やすみわきのうでしたか？",
      "provider": "elevenlabs"
    },
    {
      "cardId": "u007-c100",
      "status": "complete",
      "path": "/media/jp/audio/unit_007/u007-c100.mp3",
      "text": "仕事は去年でしたか？",
      "speechText": "しごとわきょねんでしたか？",
      "provider": "elevenlabs"
    }
