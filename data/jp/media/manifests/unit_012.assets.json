      "path": "/media/jp/audio/unit_012/u012-c088.mp3",
      "text": "学生は簡単です",
      "speechText": "がくせいわかんたんです"
    },
    {
      "cardId": "u012-c089",
      "status": "queued",
      "path": "/media/jp/audio/unit_012/u012-c089.mp3",
      "text": "大切な学生です",
      "speechText": "たいせつながくせいです"
    },
    {
      "cardId": "u012-c090",
      "status": "queued",
      "path": "/media/jp/audio/unit_012/u012-c090.mp3",
      "text": "大人は安全ですか？",
      "speechText": "おとなわあんぜんですか？"
    },
    {
      "cardId": "u012-c091",
      "status": "queued",
      "path": "/media/jp/audio/unit_012/u012-c091.mp3",
      "text": "あそこに机があります",
      "speechText": "あそこにつくえがあります"
    },
    {
      "cardId": "u012-c092",
      "status": "queued",
      "path": "/media/jp/audio/unit_012/u012-c092.mp3",
      "text": "ここは大きいですか？",
      "speechText": "ここわおおきいですか？"
    },
    {
      "cardId": "u012-c093",
      "status": "queued",
      "path": "/media/jp/audio/unit_012/u012-c093.mp3",
      "text": "そこは小さいですか？",
