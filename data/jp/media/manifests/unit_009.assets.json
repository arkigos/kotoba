    },
    {
      "cardId": "u009-c098",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c098.mp3",
      "text": "明日は風ですよ",
      "speechText": "あしたわかぜですよ"
    },
    {
      "cardId": "u009-c099",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c099.mp3",
      "text": "明日は空ですね",
      "speechText": "あしたわそらですね"
    },
    {
      "cardId": "u009-c100",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c100.mp3",
      "text": "彼は食べ物を食べますよ",
      "speechText": "かれわたべものをたべますよ"
    },
    {
      "cardId": "u009-c101",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c101.mp3",
      "text": "海は何ですか？",
