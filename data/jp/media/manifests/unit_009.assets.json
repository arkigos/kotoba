    },
    {
      "cardId": "u009-c095",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c095.mp3",
      "text": "明日は雨ですよ",
      "speechText": "あしたわあめですよ"
    },
    {
      "cardId": "u009-c096",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c096.mp3",
      "text": "あなたは勉強しますね",
      "speechText": "あなたわべんきょうしますね"
    },
    {
      "cardId": "u009-c097",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c097.mp3",
      "text": "明日は雪ですね",
