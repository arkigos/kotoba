      "cardId": "u009-c090",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c090.mp3",
      "text": "町はどこですか？",
      "speechText": "まちわどこですか？"
    },
    {
      "cardId": "u009-c091",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c091.mp3",
      "text": "島はどこですか？",
      "speechText": "しまわどこですか？"
    },
    {
      "cardId": "u009-c092",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c092.mp3",
      "text": "私は働きますね",
      "speechText": "わたしわはたらきますね"
    },
    {
      "cardId": "u009-c093",
      "status": "queued",
      "path": "/media/jp/audio/unit_009/u009-c093.mp3",
      "text": "国はどこですか？",
